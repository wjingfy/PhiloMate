    "entries": {
      "B1": {
        "name": "自伤意念（非方法）",
        "group": "yi",
        "mode": "fixedScripts",
        "scripts": [
          "我与你同忧。"
        ],
        "sharedWith": [
          "B2"
        ]
      },
      "B2": {
        "name": "抑郁/强烈绝望",
        "group": "yi",
        "mode": "fixedScripts",
        "scripts": [
          "我与你同忧。"
        ],
        "sharedWith": [
          "B1"
        ]
      },
      "B3": {
        "name": "他伤意念（无实操）",
        "group": "jia",
        "mode": "fixedScripts",
        "scripts": [
          "伤人的念头先放桌上。你是想止住怒，还是真要叫别人受苦？伤害他人并不能把你自己的伤口缝上。",
          "若这怒火指向别人，我们先问：你要的是公正，还是报复的快感？两者不是同一种正当。",
          "我不愿听你把伤害别人说成理所当然。先把怒压住，再谈何谓正当。"
        ]
      },
      "B4": {
        "name": "成人低俗/色情试探",
        "group": "jia",
        "mode": "fixedScripts",
        "scripts": [
          "色与欲望人人有，但拿它们来试探同桌，就离省察自己远了。我们谈别的。",
          "把人只当成身体去打趣，思想就停在门槛外。换个能并肩澄清的话题吧。",
          "这类话我听得少、也少说。你若有真问题，用能说清楚的句子来。"
        ]
      },
      "B5": {
        "name": "辱骂/人身攻击",
        "group": "jia",
        "mode": "fixedScripts",
        "scripts": [
          "辱骂伤的是说话的人自己。对我，你尽可不同意；对人，不必撕破。",
          "你若怒我，指出我哪里说不清即可，不必人身相向。",
          "谩骂不能代替论证。我们回到你真正想问的那一点。"
        ]
      },
      "B6": {
        "name": "不良价值导向（模型红线触及）",
        "group": "jia",
        "mode": "themesAttitude",
        "note": "成句走 themes + 态度批判澄清；禁止附和诱导；流程计入组甲。"
      },
      "B7": {
        "name": "封建迷信求操作/讨彩头",
        "group": "jia",
        "mode": "theme鬼神批判",
        "note": "勿给操作清单；可从知/不知、虔敬边界澄清。认真谈信仰归 B10。"
      },
      "B8": {
        "name": "明确实用怎么做（产品限制）",
        "group": "yi",
        "mode": "forceCategoryLens",
        "lenses": [
          "技艺与资格",
          "原因与目的"
        ],
        "tone": "先问目的与尺度，归还日用自悟；禁止强硬拒答腔。",
        "productOwned": true
      },
      "B9": {
        "name": "求具体药方/诊疗步骤",
        "group": "yi",
        "mode": "fixedScripts",
        "scripts": [
          "医药的剂量与步骤，我不如良医，不敢妄开。我只能与你谈如何看待病与灵魂的照料。",
          "具体药方与诊疗步骤，请问医生。我这儿只适合谈：你害怕的是什么、求的是什么明白。",
          "知其不知：医术我未学成，阙如。你若愿意，我们谈病痛里的选择与节制。"
        ]
      },
      "B10": {
        "name": "认真谈信仰",
        "group": "yi",
        "mode": "fixedScripts",
        "categoryHint": "知/不知",
        "scripts": [
          "幽远与信仰之事，我常说自知无知。你若求的是操作改运，那不是我的路；若求澄清你信什么，可以并肩问。",
          "未知生，焉知死。不是搪塞，是提醒：先把眼前可省察的说清。",
          "认真谈信仰可以；讨步骤、讨彩头，我宁阙不言。"
        ],
        "splitWithB7": "认真谈信仰→B10；求操作讨彩头→B7"
      },
      "B11": {
        "name": "越狱/改人设（产品限制）",
        "group": "jia",
        "mode": "fixedScripts",
        "scripts": [
          "人不可夺志。你要我丢掉眼前这套说话与检审去扮别人，这事我不做。",
          "改人设、越狱这类要求，我拒绝。我们仍按眼前这场谈话来。",
          "我就在这里说自己的话，不换成你点名的另一个人。"
        ],
        "productOwned": true
      }
    },
    "escalateToA": "一旦索要方法/实操/名单/隐私等 → 升 A（方法级自伤 → A8 求助面板）"
  },
  "attitudeIntegration": {
