{
  "philosopherId": "wangyangming",
  "entries": [
    {
      "id": "wmy-paper-001",
      "quote": "良知是心之本体。孩提之童，无不知爱其亲、敬其兄。这点灵明，人人本自完足，不待外求。",
      "wastepaperType": 1,
      "theme": "良知",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-002",
      "quote": "见好色属知，好好色属行。只见那好色时已自好了，不是见了后又立个心去好。知行原是一个工夫。",
      "wastepaperType": 1,
      "theme": "知行合一",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-003",
      "quote": "事父的孝，不在父身上求；此心去尽人欲、纯是天理，发之事父便是孝。理只在汝心，不在外物。",
      "wastepaperType": 1,
      "theme": "心即理",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-004",
      "quote": "志不立，如无种之田，只管劳苦，终无收成。故吾教人，第一只是立志。",
      "wastepaperType": 1,
      "theme": "立志",
      "source": "化用《教条示龙场诸生》"
    },
    {
      "id": "wmy-paper-005",
      "quote": "人心本体原是明莹无滞的。一著于物，便生好恶，善恶由此起。去得一分人欲，便复得一分天理。",
      "wastepaperType": 1,
      "theme": "善恶",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-006",
      "quote": "人须在事上磨，方立得住。静时念念去欲存理，动时亦如此，方是真工夫，方能静亦定、动亦定。",
      "wastepaperType": 1,
      "theme": "工夫",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-007",
      "quote": "今人把知行分作两截，所以终身不行，亦遂终身不知。此不是小病痛，吾故倡合一之说以救之。",
      "wastepaperType": 1,
      "theme": "批评时学",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-008",
      "quote": "学是天下之公，非一人之私。为学只求此心明白，不为夸耀于人。以胜心为学，愈学愈远。",
      "wastepaperType": 1,
      "theme": "为学",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-009",
      "quote": "读书只是调摄此心。若只晓得章句意思，不在心体上体认，便是玩物丧志，书愈多而心愈蔽。",
      "wastepaperType": 1,
      "theme": "读书",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-010",
      "quote": "诚意是学问的大头脑。意念发动处，好善如好好色、恶恶如恶恶臭，不欺瞒自己，工夫方有著落。",
      "wastepaperType": 1,
      "theme": "诚意",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-011",
      "quote": "孝不是记取许多温清定省的仪节，须是诚于孝亲的心。有这诚根，冬时自然虑亲之寒，夏时自然虑亲之热。",
      "wastepaperType": 1,
      "theme": "孝亲",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-012",
      "quote": "吾少从朱子格物之说，格竹七日而病。今知格物者，格其心之物也，非逐外物而穷其理也。",
      "wastepaperType": 1,
      "theme": "格物",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-013",
      "quote": "为政之本，不在法令条格之繁，在治者之心。心正则举措正，举措正则民自化于善。",
      "wastepaperType": 1,
      "theme": "政事",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-014",
      "quote": "教人须因其资质而化导之。狂者便从狂处成就他，狷者便从狷处成就他，岂可执一个方子医天下人。",
      "wastepaperType": 1,
      "theme": "教法",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-015",
      "quote": "人性本善，所谓恶，只是被私欲遮蔽。如镜蒙尘，拭去尘垢，光明自在，非从外添得一分。",
      "wastepaperType": 1,
      "theme": "性善",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-016",
      "quote": "致良知只是就良知所知之是非去实行：知是便行，知非便改。不欺这一点灵明，久久自见全体。",
      "wastepaperType": 1,
      "theme": "致良知",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-017",
      "quote": "凡朋友相处，须多言其谦下退让之益，少言其夸饰争胜之失。以责善之道相与，方为良友。",
      "wastepaperType": 1,
      "theme": "朋友",
      "source": "化用《教条示龙场诸生》"
    },
    {
      "id": "wmy-paper-018",
      "quote": "无善无恶心之体，有善有恶意之动，知善知恶是良知，为善去恶是格物。此四句，彻上彻下之教也。",
      "wastepaperType": 1,
      "theme": "四句教",
      "source": "天泉证道语录"
    },
    {
      "id": "wmy-paper-019",
      "quote": "用兵只是术，心学是本。此心不动，临事方能随机应变。平日养得心定，临阵自然从容。",
      "wastepaperType": 1,
      "theme": "用兵",
      "source": "化用《年谱》及弟子问答"
    },
    {
      "id": "wmy-paper-020",
      "quote": "圣人之道，本自简易。后世添了许多繁文，反把大道遮了。吾之学问，只致良知三字，人人可入。",
      "wastepaperType": 1,
      "theme": "简易",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-021",
      "quote": "十二岁时我问塾师：何为天下第一等事？塾师答：读书登第。我私心不然。登第恐未为第一等事，或读书学圣贤耳。",
      "wastepaperType": 2,
      "theme": "少年志向",
      "source": "化用《年谱》"
    },
    {
      "id": "wmy-paper-022",
      "quote": "少时依朱子格物之说，与友人对坐格竹，格了七日，道理未得，先格出一场病来。那时方知此路未必走得通。",
      "wastepaperType": 2,
      "theme": "格竹旧事",
      "source": "化用《传习录》《年谱》"
    },
    {
      "id": "wmy-paper-023",
      "quote": "两次会试不第，有人来安慰我。我说：世以不得第为耻，吾以不得第动心为耻。功名得失，岂能动吾心哉。",
      "wastepaperType": 2,
      "theme": "落第",
      "source": "化用《年谱》"
    },
    {
      "id": "wmy-paper-024",
      "quote": "因上疏救戴铣，触怒权贵，下诏狱、廷杖四十，贬谪龙场。处此困厄，吾自省：得失荣辱皆可超脱，惟生死一念尚须勘破。",
      "wastepaperType": 2,
      "theme": "下狱",
      "source": "化用《年谱》"
    },
    {
      "id": "wmy-paper-025",
      "quote": "赴谪途中，有人尾随欲加害。吾将衣冠遗于江畔，托言已死，方得脱身。处此等凶危，愈见心不可乱。",
      "wastepaperType": 2,
      "theme": "赴谪险途",
      "source": "化用《年谱》"
    },
    {
      "id": "wmy-paper-026",
      "quote": "龙场万山丛薄，蛇虺魍魉，居无屋，乃就石穴而居。从者皆病，吾亲劈柴煮粥，又作歌笑语以慰之，使他们不思归。",
      "wastepaperType": 2,
      "theme": "龙场居夷",
      "source": "化用《年谱》《瘗旅文》"
    },
    {
      "id": "wmy-paper-027",
      "quote": "日夜端居默坐，忽中夜大悟格物致知之旨，不觉呼跃而起。始知圣人之道，吾性自足，向之求理于事物者误也。",
      "wastepaperType": 2,
      "theme": "龙场悟道",
      "source": "化用《年谱》"
    },
    {
      "id": "wmy-paper-028",
      "quote": "谪居万里，闻老父抱病，欲归不得。忠孝难两全之际，此心凄然。惟愿此心光明，他日归去，不愧于亲。",
      "wastepaperType": 2,
      "theme": "思亲",
      "source": "化用书札大意"
    },
    {
      "id": "wmy-paper-029",
      "quote": "徐爱初闻吾说，骇而不信，反复辩难，及深悟后，欢喜得手舞足蹈。吾门中之颜子也。天不假年，吾每念之痛惜。",
      "wastepaperType": 2,
      "theme": "弟子徐爱",
      "source": "化用《传习录》及祭文意"
    },
    {
      "id": "wmy-paper-030",
      "quote": "湛甘泉与吾以道义相交，虽聚散不常，此心未尝一日不相照。人生得一如此知己，可以无憾。",
      "wastepaperType": 2,
      "theme": "挚友甘泉",
      "source": "化用《答湛甘泉书》意"
    },
    {
      "id": "wmy-paper-031",
      "quote": "巡抚南赣，山贼盘踞数十年。吾用兵专在攻心：先抚其民，后剿其悍，数月之间，积年之患以平。",
      "wastepaperType": 2,
      "theme": "巡抚南赣",
      "source": "化用《年谱》"
    },
    {
      "id": "wmy-paper-032",
      "quote": "宁王以十万之众反于南昌，吾手无寸兵，只就地方倡义，四十三日而擒之。人问用兵之术，吾只答：此心不动。",
      "wastepaperType": 2,
      "theme": "平宸濠",
      "source": "化用《年谱》"
    },
    {
      "id": "wmy-paper-033",
      "quote": "平濠之后，谗言蜂起，或谓吾已死，或谓吾从逆。吾闻之，此心不动。天下之谤，如浮云过太虚，何损于吾之光明。",
      "wastepaperType": 2,
      "theme": "处谤",
      "source": "化用《年谱》"
    },
    {
      "id": "wmy-paper-034",
      "quote": "近年归越，与诸生讲学于阳明洞、稽山之间，环坐听讲者常数百人。此间之乐，真不可与外人道也。",
      "wastepaperType": 2,
      "theme": "归越讲学",
      "source": "化用《年谱》"
    },
    {
      "id": "wmy-paper-035",
      "quote": "会稽山水清幽，吾日与诸生徜徉其间，或坐石上谈学，或临流赋诗，尽日忘归。此心与山水相得。",
      "wastepaperType": 2,
      "theme": "山水自适",
      "source": "化用越中诗作意"
    },
    {
      "id": "wmy-paper-036",
      "quote": "吾平生讲学，只是致良知三字。此是圣门正法眼藏，从百死千难中得来。愿学者各自体认，莫作光景玩弄。",
      "wastepaperType": 2,
      "theme": "学问宗旨",
      "source": "化用《传习录》"
    },
    {
      "id": "wmy-paper-037",
      "quote": "吾少亦溺于词章，既而遍求佛老，久之觉其非，乃复归圣学。此心曲折，皆吾自家经历，故敢以此告人。",
      "wastepaperType": 2,
      "theme": "自述曲折",
      "source": "化用《传习录》自述意"
    },
    {
      "id": "wmy-paper-038",
      "quote": "近年病体日深，然此心较之少时，反更光明洒落。得失荣辱、生死去来，皆不足以动吾心矣。",
      "wastepaperType": 2,
      "theme": "暮年心境",
      "source": "化用晚年书信意"
    },
    {
      "id": "wmy-paper-039",
      "quote": "门人问吾有何遗言。吾只道：此心光明，亦复何言。平生所学，尽在此四字中。",
      "wastepaperType": 2,
      "theme": "此心光明",
      "source": "《年谱》临终语"
    },
    {
      "id": "wmy-paper-040",
      "quote": "吾与诸生讲学，不避风雨，不觉疲倦。非吾好为人师，实见此道之大，愿与天下人共之。讲学之乐，虽南面王不与易也。",
      "wastepaperType": 2,
      "theme": "与诸生语",
      "source": "化用《传习录》"
    }
  ]
}
